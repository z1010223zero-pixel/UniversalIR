<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_app"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_remote"
        android:shortcutShortLabel="@string/shortcut_open_label">
        <!-- 静态快捷方式只认 <intent> 子元素；<intent-filter> 会被 ShortcutParser 直接跳过 -->
        <intent
            android:action="android.intent.action.VIEW"
            android:data="uniir://home"
            android:targetPackage="com.zero.universalir"
            android:targetClass="com.zero.universalir.MainActivity" />
    </shortcut>
</shortcuts>
